{
  "name": "pi-token-summary",
  "version": "0.2.0",
  "description": "Token/cost inline stats for the pi coding agent: dim transcript line with this turn's output, cumulative tokens, context %, and cost. Modes via /token-summary 详细|简略|关.",
  "type": "module",
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "token-usage",
    "token-summary",
    "cost"
  ],
  "author": "lei",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.86.0"
  }
}
