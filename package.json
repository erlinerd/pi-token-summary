{
  "name": "@erlin-ai/pi-token-summary",
  "version": "0.2.1",
  "description": "Token/cost inline stats for the pi coding agent: dim transcript line with this turn's output, cumulative tokens, context %, and cost. Modes via /token-summary verbose|brief|off.",
  "type": "module",
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "token-usage",
    "token-summary",
    "cost"
  ],
  "author": "erlinerd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erlinerd/pi-token-summary.git"
  },
  "bugs": {
    "url": "https://github.com/erlinerd/pi-token-summary/issues"
  },
  "homepage": "https://github.com/erlinerd/pi-token-summary#readme",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
